generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model carrito_items {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  carrito_id     String       @db.Uuid
  medicamento_id String       @db.Uuid
  cantidad       Int
  carritos       carritos     @relation(fields: [carrito_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  medicamentos   medicamentos @relation(fields: [medicamento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([carrito_id, medicamento_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model carritos {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id    String          @unique @db.Uuid
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  carrito_items carrito_items[]
  usuarios      usuarios        @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model categorias {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre       String         @unique @db.VarChar(80)
  descripcion  String?
  activo       Boolean        @default(true)
  medicamentos medicamentos[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model medicamentos {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String            @db.VarChar(200)
  descripcion     String?
  precio          Decimal           @db.Decimal(12, 2)
  imagen_url      String?
  categoria_id    String?           @db.Uuid
  requiere_receta Boolean           @default(false)
  stock           Int               @default(0)
  activo          Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  carrito_items   carrito_items[]
  categorias      categorias?       @relation(fields: [categoria_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pedido_items    pedido_items[]
  receta_detalles receta_detalles[]

  @@index([activo, requiere_receta], map: "idx_medicamentos_catalogo")
  @@index([categoria_id], map: "idx_medicamentos_categoria")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model mensajes_contacto {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre     String   @db.VarChar(100)
  correo     String   @db.VarChar(255)
  asunto     String?  @db.VarChar(150)
  mensaje    String
  estado     String   @default("pendiente") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([estado], map: "idx_mensajes_estado")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model pedido_items {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedido_id         String           @db.Uuid
  medicamento_id    String           @db.Uuid
  receta_detalle_id String?          @db.Uuid
  nombre_producto   String           @db.VarChar(200)
  precio_unitario   Decimal          @db.Decimal(12, 2)
  cantidad          Int
  subtotal          Decimal          @db.Decimal(12, 2)
  medicamentos      medicamentos     @relation(fields: [medicamento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pedidos           pedidos          @relation(fields: [pedido_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  receta_detalles   receta_detalles? @relation(fields: [receta_detalle_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([medicamento_id], map: "idx_pedido_items_medicamento")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model pedidos {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id        String         @db.Uuid
  estado            String         @default("pendiente") @db.VarChar(20)
  subtotal          Decimal        @db.Decimal(12, 2)
  total             Decimal        @db.Decimal(12, 2)
  direccion_entrega String
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime       @default(now()) @db.Timestamptz(6)
  pedido_items      pedido_items[]
  usuarios          usuarios       @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([estado], map: "idx_pedidos_estado")
  @@index([usuario_id, created_at(sort: Desc)], map: "idx_pedidos_usuario_fecha")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model receta_detalles {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receta_id          String         @db.Uuid
  medicamento_id     String         @db.Uuid
  cantidad_prescrita Int?
  indicaciones       String?
  pedido_items       pedido_items[]
  medicamentos       medicamentos   @relation(fields: [medicamento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recetas            recetas        @relation(fields: [receta_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([receta_id, medicamento_id])
  @@index([medicamento_id], map: "idx_receta_detalles_medicamento")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model recetas {
  id                                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id                              String            @db.Uuid
  archivo_url                             String
  estado                                  String            @default("pendiente") @db.VarChar(20)
  revisado_por                            String?           @db.Uuid
  fecha_revision                          DateTime?         @db.Timestamptz(6)
  observaciones                           String?
  created_at                              DateTime          @default(now()) @db.Timestamptz(6)
  receta_detalles                         receta_detalles[]
  usuarios_recetas_revisado_porTousuarios usuarios?         @relation("recetas_revisado_porTousuarios", fields: [revisado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios_recetas_usuario_idTousuarios   usuarios          @relation("recetas_usuario_idTousuarios", fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([estado], map: "idx_recetas_estado")
  @@index([revisado_por], map: "idx_recetas_revisor")
  @@index([usuario_id], map: "idx_recetas_usuario")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model roles {
  id          Int        @id @default(autoincrement()) @db.SmallInt
  nombre      String     @unique @db.VarChar(30)
  descripcion String?
  usuarios    usuarios[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model usuarios {
  id                                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre                                 String    @db.VarChar(100)
  correo                                 String    @unique @db.VarChar(255)
  password_hash                          String
  rol_id                                 Int       @db.SmallInt
  activo                                 Boolean   @default(true)
  created_at                             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                             DateTime  @default(now()) @db.Timestamptz(6)
  carritos                               carritos?
  pedidos                                pedidos[]
  recetas_recetas_revisado_porTousuarios recetas[] @relation("recetas_revisado_porTousuarios")
  recetas_recetas_usuario_idTousuarios   recetas[] @relation("recetas_usuario_idTousuarios")
  roles                                  roles     @relation(fields: [rol_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
